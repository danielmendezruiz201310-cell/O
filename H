local touchTimestamps = {}
local sessionWarmupStart = tick()

local function humanPacingWait()
    if not EVASION.humanPacing then return end
    -- roughly Poisson-ish human reaction delay: 15-45ms skewed
    local base = 0.015 + (math.random()^2) * 0.030
    return base
end

local function reachRateOk()
    if not EVASION.reachAntiDetect then return true end
    -- warmup: prevent instant burst on inject
    if tick() - sessionWarmupStart < EVASION.warmupSeconds then
        return false
    end
    local now = tick()
    local kept = {}
    for _,t in ipairs(touchTimestamps) do
        if now - t < 1.0 then kept[#kept+1] = t end
    end
    touchTimestamps = kept
    if #touchTimestamps >= EVASION.maxTouchesPerSec then
        SESSION.reachBlocks += 1
        return false
    end
    return true
end

local function reachRecordTouch()
    touchTimestamps[#touchTimestamps+1] = tick()
end

local function adaptiveThrottle(base)
    if not EVASION.adaptiveThrottle then return base end
    -- more touches recently → longer cooldown
    local now = tick()
    local recent = 0
    for _,t in ipairs(touchTimestamps) do
        if now - t < 2.0 then recent += 1 end
    end
    local load = math.min(recent / EVASION.maxTouchesPerSec, 1)
    return base * (1 + load * 0.6)
end

local function pickLimbs(limbs)
    if not EVASION.enabled or #limbs <= EVASION.limbSubsetMin then
        return limbs
    end
    local pool = {}
    for i=1,#limbs do pool[i]=limbs[i] end
    for i=#pool,2,-1 do
        local j = math.random(i)
        pool[i],pool[j] = pool[j],pool[i]
    end
    local n = math.random(EVASION.limbSubsetMin, math.min(EVASION.limbSubsetMax, #limbs))
    local out = {}
    for i=1,n do out[i]=pool[i] end
    return out
end
local function noiseVec(mag)
    if not EVASION.enabled then return Vector3.zero end
    local m = mag or EVASION.posNoise
    return Vector3.new((math.random()*2-1)*m, (math.random()*2-1)*m, (math.random()*2-1)*m)
end

