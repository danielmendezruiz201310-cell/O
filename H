    debug_setconstant=type(debug)=="table" and type(debug.setconstant)=="function",
}
local function safeHookMethod(obj, name, fn)
    if not CAP.hookmetamethod then return nil end
    local ok, ret = pcall(hookmetamethod, obj, name, fn)
    return ok and ret or nil
end
local function safeHookFunction(orig, fn)
    if not CAP.hookfunction or type(orig)~="function" then return nil end
    local ok, ret = pcall(hookfunction, orig, fn)
    return ok and ret or nil
end
local function safeFireTouch(a, b, state)
    if not CAP.firetouchinterest then return end
    pcall(firetouchinterest, a, b, state)
end

