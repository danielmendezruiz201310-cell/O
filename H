Section(MatchPage,"MATCH OVERVIEW", C.gold)
local matchCard = Instance.new("Frame",MatchPage)
matchCard.Size=UDim2.new(1,-8,0,320); matchCard.BackgroundColor3=C.panel2
matchCard.BorderSizePixel=0; corner(matchCard,12); stroke(matchCard,C.border)
local matchLabel = Instance.new("TextLabel",matchCard)
matchLabel.Size=UDim2.new(1,-24,1,-16); matchLabel.Position=UDim2.new(0,12,0,8)
matchLabel.BackgroundTransparency=1; matchLabel.TextColor3=C.text
matchLabel.Font=Enum.Font.Code; matchLabel.TextSize=11
matchLabel.TextXAlignment=Enum.TextXAlignment.Left; matchLabel.TextYAlignment=Enum.TextYAlignment.Top
matchLabel.TextWrapped=true; matchLabel.Text="Loading..."
task.spawn(function()
    while matchCard.Parent do
        local md = getMatchData()
        local lines = {}
        local function pRow(p,tag)
            return string.format("  [%s] %-20s  Pos:%-6s  Flags:%d  %s",
                tag, p.name, p.position, p.flags,
                p.status=="FLAGGED" and "⚠ FLAGGED" or "✓ CLEAN")
        end
        table.insert(lines,"HOME — "..md.homeName); table.insert(lines, string.rep("─",36))
        if md.home.gk then table.insert(lines, pRow(md.home.gk,"GK"))
        else table.insert(lines,"  [GK] — not detected") end
        for _,p in md.home.players do table.insert(lines,pRow(p,"FD")) end
        table.insert(lines,""); table.insert(lines,"AWAY — "..md.awayName)
        table.insert(lines, string.rep("─",36))
        if md.away.gk then table.insert(lines, pRow(md.away.gk,"GK"))
        else table.insert(lines,"  [GK] — not detected") end
        for _,p in md.away.players do table.insert(lines,pRow(p,"FD")) end
        matchLabel.Text = table.concat(lines,"\n")
        task.wait(2)
    end
end)

