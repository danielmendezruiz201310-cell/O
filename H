local vizParts = {}
local lastVizUpdate, VIZ_INTERVAL = 0, 1/30
local function makeVizPart(bid)
    local vp = Instance.new("Part")
    vp.Name = "\0"..bid
    vp.Anchored=true; vp.CanCollide=false; vp.CanQuery=false; vp.CanTouch=false
    vp.Massless=true; vp.CastShadow=false
    vp.Shape = Enum.PartType.Ball
    vp.Material = nuluxSettings.vizQuality==1 and Enum.Material.ForceField or Enum.Material.SmoothPlastic
    vp.Color = Color3.fromRGB(0,200,255)
    vp.Transparency = 1
    return vp
end
local function updateAllViz()
    local now = tick()
    if now-lastVizUpdate<VIZ_INTERVAL then return end
    lastVizUpdate = now
    local container = (EVASION.hideVizFromScanner and Workspace.CurrentCamera) or Workspace
    if not (nuluxSettings.reachVis or nuluxSettings.gkReachVis) then
        if next(vizParts) then
            for _,vp in pairs(vizParts) do vp.Parent = nil end
            vizParts = {}
        end
        return
    end
    local totalX = nuluxSettings.reachX
    local totalY = nuluxSettings.reachY
    local totalZ = nuluxSettings.reachZ
    local trans = nuluxSettings.reachTransparency/100
    local sizeV = Vector3.new(totalX,totalY,totalZ)
    local ballSet = {}
    for _,ball in getAllBalls() do
        if validateBall(ball) then
            local bid = tostring(ball)
            ballSet[bid] = true
            local vp = vizParts[bid]
            if not vp or not vp.Parent then
                vp = makeVizPart(bid); vp.Parent = container; vizParts[bid] = vp
            elseif vp.Parent ~= container then
                vp.Parent = container
            end
            vp.Size = sizeV
            vp.CFrame = CFrame.new(ball.Position)
            vp.Transparency = trans
        end
    end
    for bid,vp in pairs(vizParts) do
        if not ballSet[bid] then vp.Parent = nil; vizParts[bid] = nil end
    end
end

