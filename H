        return string.format("> %s `%s`%s  `%s`  Flags:`%d`", badge, p.name, gkTag, side, p.flags)
    end
    table.insert(lines, ic("home").."**"..md.homeName.."**  `HOME`")
    if md.home.gk then table.insert(lines, row(md.home.gk,"HOME"))
    else table.insert(lines,"> 🧤 `—` **[HOME GK]**  Not Detected") end
