local function blockContact(ballName, dist, vel, kind, eventId)
    local speed = vel.Magnitude
    local dir = "—"
    if speed>1 then
        local d = vel.Unit
        dir = (math.abs(d.X)>math.abs(d.Z)) and (d.X>0 and "E →" or "W ←") or (d.Z>0 and "S ↓" or "N ↑")
        if d.Y>0.3 then dir=dir.." ↑" elseif d.Y<-0.3 then dir=dir.." ↓" end
    end
    local maxR = math.max(nuluxSettings.reachX,1)
    local pct = math.clamp(dist/maxR,0,1)
    return string.format(
        "%s**CONTACT  ·  `%s`**\n> %s`%-12s` `%s`\n> %s`%-12s` `%.2f studs`\n> %s`%-12s` `%.2f s/s`\n> %s`%-12s` `%s`\n> %s`%-12s` `%s`\n> `%s` `%d%%`",
        ic("ball"), eventId or genEventId(),
        ic("ball"),"BALL", ballName,
        ic("distance"),"DISTANCE", dist,
        ic("velocity"),"SPEED", speed,
        ic("velocity"),"DIR", dir,
        ic("hitbox"),"KIND", kind or "reach-contact",
        bar(pct,14), math.floor(pct*100))
end
