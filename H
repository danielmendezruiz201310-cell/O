local function getRequestFn()
    for _,fn in ipairs({(syn and syn.request),(http and http.request),(fluxus and fluxus.request),
        (krnl and krnl.request),http_request,request}) do
        if type(fn)=="function" then return fn end
    end
end
local _requestFn, _reqFailures = getRequestFn(), 0
local function rawPost(url, body)
    if not _requestFn then _reqFailures+=1; return false end
    local ok,res = pcall(function()
        return _requestFn({Url=url,Method="POST",
            Headers={["Content-Type"]="application/json"},
            Body=HttpService:JSONEncode(body)})
    end)
    if not ok then _reqFailures+=1 end
    return ok,res
end

