local function detectPosition(p)
    local char = p.Character; if not char then return "FIELD" end
    local ok,pos = pcall(function() return p:GetAttribute("Position") or char:GetAttribute("Position") end)
    if ok and pos then return tostring(pos):upper() end
    local name = p.Name:lower()
    if name:find("gk") or name:find("keeper") or name:find("goal") then return "GK" end
    return "FIELD"
end
local function isGK(p) return detectPosition(p)=="GK" end
local function getMatchData()
    local homeTeam, awayTeam
    local allTeams = Teams:GetTeams()
    if #allTeams>=2 then homeTeam=allTeams[1] awayTeam=allTeams[2]
    elseif #allTeams==1 then homeTeam=allTeams[1] end
    local home, away = {gk=nil,players={}}, {gk=nil,players={}}
    for _,p in Players:GetPlayers() do
        local side = nil
        if homeTeam and p.Team==homeTeam then side="home"
        elseif awayTeam and p.Team==awayTeam then side="away" end
        if side then
            local entry = {name=p.Name,id=p.UserId,position=detectPosition(p),
                team=p.Team and p.Team.Name or "—",flags=0,status="CLEAN"}
            for _,log in acLog do
                if log.player==p.Name then entry.flags+=1 entry.status="FLAGGED" end
            end
            if isGK(p) then
                if side=="home" then home.gk=entry else away.gk=entry end
            else
                if side=="home" then table.insert(home.players,entry)
                else table.insert(away.players,entry) end
            end
        end
    end
    return {home=home, away=away,
        homeName=homeTeam and homeTeam.Name or "HOME",
        awayName=awayTeam and awayTeam.Name or "AWAY",
        homeHex=homeTeam and string.format("#%02X%02X%02X",
            math.floor(homeTeam.TeamColor.Color.R*255),math.floor(homeTeam.TeamColor.Color.G*255),
            math.floor(homeTeam.TeamColor.Color.B*255)) or "#4FC3F7",
        awayHex=awayTeam and string.format("#%02X%02X%02X",
            math.floor(awayTeam.TeamColor.Color.R*255),math.floor(awayTeam.TeamColor.Color.G*255),
            math.floor(awayTeam.TeamColor.Color.B*255)) or "#EF5350"}
end
local function blockMatch()
    local md = getMatchData()
    local lines = {}
    local function row(p, side)
        local badge = p.status=="FLAGGED" and "⚠️" or "✅"
