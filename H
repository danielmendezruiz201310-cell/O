-- ================================================================
-- AC INTERCEPTOR (capability-safe)
-- ================================================================
local intercepting = false
local function installACInterceptor()
    if not EVASION.acIntercept then return end
    if not (CAP.getrawmetatable and CAP.setreadonly and CAP.newcclosure) then
        warn("[Nulux] raw-metatable access unavailable — AC interceptor off")
        return
    end
    local ok, mt = pcall(getrawmetatable, game)
    if not ok or not mt then return end
    local old = rawget(mt, "__namecall")
    if type(old)~="function" then return end
    local hooked = newcclosure(function(self, ...)
        if intercepting then return old(self, ...) end
        local method = CAP.getnamecallmethod and getnamecallmethod() or nil
        if (method=="FireServer" or method=="InvokeServer") and type(self)=="userdata" then
            local ok2, isAC = pcall(function()
                return (self:IsA("RemoteEvent") or self:IsA("RemoteFunction"))
                    and isRealACRemote(self.Name)
            end)
            if ok2 and isAC then
                -- Detect GoldEye-sourced remote specifically
                local isGold = self.Name:lower():find("gold") ~= nil
                SESSION.spoofedReports += 1
                SESSION.evasions += 1
                if isGold then
                    pcall(function()
                        reportGoldEye("REMOTE_BLOCK","Blocked "..self.Name,3)
                    end)
                end
                if method=="InvokeServer" then
                    return { success=true, verified=true, valid=true, ok=true }
                end
                return nil
            end
        end
        return old(self, ...)
    end)
    pcall(setreadonly, mt, false)
    rawset(mt, "__namecall", hooked)
    pcall(setreadonly, mt, true)
end

