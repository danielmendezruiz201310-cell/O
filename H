    local folder = ensurePredFolder()
    local cache = predCache[bid]
    if not cache then cache = {segs={}, halos={}}; predCache[bid] = cache end
    local segs, halos = cache.segs, cache.halos
    while #segs<count do
        local s = Instance.new("Part")
        s.Anchored=true; s.CanCollide=false; s.CanQuery=false; s.CanTouch=false
        s.Massless=true; s.CastShadow=false
        s.Material=Enum.Material.Neon; s.Shape=Enum.PartType.Block
        s.Size=Vector3.new(0.4,0.4,1); s.Parent=folder
        table.insert(segs, s)
    end
    while #halos<count do
        local h = Instance.new("Part")
        h.Anchored=true; h.CanCollide=false; h.CanQuery=false; h.CanTouch=false
        h.Massless=true; h.CastShadow=false
        h.Material=Enum.Material.Neon; h.Shape=Enum.PartType.Block
        h.Size=Vector3.new(1,1,1); h.Parent=folder
        table.insert(halos, h)
    end
    for i=count+1,#segs do segs[i].Transparency = 1 end
    for i=count+1,#halos do halos[i].Transparency = 1 end
    return segs, halos
end
local function simulateTrajectory(startPos, startVel, steps, dt)
    local GRAVITY = Vector3.new(0, -Workspace.Gravity, 0)
    local BOUNCE  = nuluxSettings.predBounceDamp
    local FRIC    = nuluxSettings.predFriction
    local GROUNDY = nuluxSettings.predGroundY
    local pts = {startPos}
    local pos, vel = startPos, startVel
    for i=1,steps do
        vel = vel + GRAVITY*dt
        local npos = pos + vel*dt
        if nuluxSettings.predBounces and npos.Y<GROUNDY and vel.Y<0 then
            npos = Vector3.new(npos.X, GROUNDY, npos.Z)
            vel  = Vector3.new(vel.X*FRIC, -vel.Y*BOUNCE, vel.Z*FRIC)
        end
        pos = npos
        table.insert(pts, pos)
        if pos.Y<-20 then break end
    end
    return pts
end
local function updateBallPrediction()
    local now = tick()
    if now-lastPredUpdate<PRED_INTERVAL then return end
    lastPredUpdate = now
    if not nuluxSettings.ballPredOn then
        for bid in pairs(predCache) do destroyPredCache(bid) end
        return
    end
    local active = {}
    local baseHue = ((now+HUE_SEED)*nuluxSettings.predRainbowSpeed)%1
    local W = nuluxSettings.predLineWidth
    for _,ball in getAllBalls() do
        if validateBall(ball) then
            local vel = ball.AssemblyLinearVelocity
            if vel and vel.Magnitude>=nuluxSettings.predMinSpeed then
                local bid = tostring(ball)
                active[bid] = true
                local pts = simulateTrajectory(ball.Position, vel, nuluxSettings.predSteps, 0.02)
                local step = math.max(1, math.floor(#pts/60))
                local drawn = {}
                for i=1,#pts,step do table.insert(drawn, pts[i]) end
                if drawn[#drawn] ~= pts[#pts] then table.insert(drawn, pts[#pts]) end
                if #drawn<2 then destroyPredCache(bid); continue end
                local segs, halos = ensurePredSegments(bid, #drawn-1)
                for i=1,#drawn-1 do
                    local a,b = drawn[i], drawn[i+1]
                    local diff = b-a
                    local len  = diff.Magnitude
                    local mid = (a+b)*0.5
                    local t   = i/#drawn
                    local hue = (baseHue + t*nuluxSettings.predHueSpread)%1
                    local col = Color3.fromHSV(hue, 0.9, 1)
                    local taper = nuluxSettings.predTaper and (1 - t*0.6) or 1
                    local wSeg  = math.max(0.05, W * taper)
                    local seg = segs[i]
                    if len>0.05 then
                        seg.Size = Vector3.new(wSeg, wSeg, len+0.08)
                        seg.CFrame = CFrame.lookAt(mid, b)
                        seg.Transparency = 0.05 + t*0.30
                        seg.Color = col
                    else seg.Transparency = 1 end
                    local halo = halos[i]
                    if halo then
                        if len>0.05 and nuluxSettings.predUnderlay then
                            halo.Size = Vector3.new(wSeg*2.6, wSeg*2.6, len+0.15)
                            halo.CFrame = CFrame.lookAt(mid, b)
                            halo.Transparency = 0.72 + t*0.20
                            halo.Color = col
                        else halo.Transparency = 1 end
                    end
                end
            else destroyPredCache(tostring(ball)) end
        end
    end
    for bid in pairs(predCache) do
        if not active[bid] then destroyPredCache(bid) end
    end
end

