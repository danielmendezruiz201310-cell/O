local function isGoldEyeKey(k)
    if type(k) ~= "string" then return false end
    local lower = k:lower()
    return lower:find("goldeye") ~= nil or lower:find("gold_eye") ~= nil
end

local function scanGoldEye()
    if not EVASION.goldEyeDetect then return end
    if not CAP.getgc then return end
    local hits = 0
    pcall(function()
        for _,v in pairs(getgc(true)) do
            if type(v)=="table" then
                local matched = false
                for k in pairs(v) do
                    if isGoldEyeKey(k) then matched = true; break end
                end
                if not matched and rawget(v,"__name") and isGoldEyeKey(tostring(rawget(v,"__name"))) then
                    matched = true
                end
                if matched then
                    hits += 1
                    GOLDEYE.seenTables += 1
                    -- record but don't spam flag webhook for passive presence
                end
            end
        end
    end)
    return hits
end

