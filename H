local contactLast = {}
local function fireBallContact(char, ball)
    local limbs = getLimbs(char); if #limbs==0 then return end
    local picked = pickLimbs(limbs)
    local order = {}
    for i=1,#picked do order[i]=picked[i] end
    for i=#order,2,-1 do local j=math.random(i); order[i],order[j]=order[j],order[i] end
    for _,limb in order do safeFireTouch(limb, ball, 0) end
    task.defer(function()
        task.wait(humanPacingWait() or 0.03)
        local order2 = {}
        for i=1,#picked do order2[i]=picked[i] end
        for i=#order2,2,-1 do local j=math.random(i); order2[i],order2[j]=order2[j],order2[i] end
        for _,limb in order2 do safeFireTouch(limb, ball, 1) end
    end)
end
local function firePlayerContact(char, target, limbs)
    local picked = pickLimbs(limbs)
    for _,limb in picked do safeFireTouch(limb, target, 0) end
    task.defer(function()
        task.wait(humanPacingWait() or 0.03)
        for _,limb in picked do safeFireTouch(limb, target, 1) end
    end)
end
local function ownershipBadge(ball)
    local ok,owner = pcall(function() return ball:GetAttribute("networkOwner") end)
    if ok and owner then
        return tostring(owner)==tostring(player.UserId) and "🟢 YOURS" or "🔴 ENEMY"
    end
    return "⚪ SHARED"
end
local function getSideTag(teamName)
    local md = getMatchData()
    if teamName==md.homeName then return "home"
    elseif teamName==md.awayName then return "away" end
end
local function trackReach(dist, flagged, isGKPlayer)
    local team = getTeamInfo()
    local side = getSideTag(team.name)
    table.insert(SESSION.reachDistances, dist)
    if #SESSION.reachDistances>200 then table.remove(SESSION.reachDistances,1) end
    updateAvgReach()
    if side then
        local key = isGKPlayer and (side=="home" and "homeGKReach" or "awayGKReach")
            or (side=="home" and "homeReach" or "awayReach")
        SESSION[key].touches += 1
        SESSION[key].totalDist += dist
        if flagged then SESSION[key].violations += 1 end
    end
end
local function doReachContact(char, ball, distToBall, hitbox, preVel, prePos, bid)
    if EVASION.enabled and math.random() < EVASION.fireSkipChance then
        SESSION.evasions += 1
        return
    end
    if not reachRateOk() then return end
    local now = tick()
    local minGap = adaptiveThrottle(nuluxSettings.contactThrottleMs/1000)
    if contactLast[bid] and (now-contactLast[bid])<minGap then return end
    contactLast[bid] = now
    local limbs = getLimbs(char); if #limbs==0 then return end
    fireBallContact(char, ball)
    reachRecordTouch()
    if nuluxSettings.reachPlayers then
        task.spawn(function()
            pcall(function()
                local params = OverlapParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {char}
                params.MaxParts = 8
                local center = CFrame.new(ball.Position + noiseVec())
                local parts = Workspace:GetPartBoundsInBox(center, hitbox, params)
                local seen = {}
                for _,part in parts do
                    local oc = part:FindFirstAncestorOfClass("Model")
                    if oc and oc~=char and oc:FindFirstChildOfClass("Humanoid") and not seen[oc] then
                        seen[oc]=true
                        firePlayerContact(char, part, limbs)
                        SESSION.contacts += 1
                    end
                end
            end)
        end)
    end
    task.defer(function()
        task.wait(humanPacingWait() or 0.05)
        if not ball.Parent then return end
        local postVel = ball.AssemblyLinearVelocity or Vector3.zero
        local postPos = ball.Position
        local velDelta = (postVel-preVel).Magnitude
        local posDelta = (postPos-prePos).Magnitude
        local realTouch = nuluxSettings.ignoreVelocityCheck
            or velDelta>=nuluxSettings.touchVelocityMin or posDelta>=0.1
        if not realTouch then return end
        local maxReach = math.max(hitbox.X,hitbox.Y,hitbox.Z)*0.5
        local flagged, reason = false, nil
        if nuluxSettings.flagUnnatural then
            if distToBall>maxReach*0.9 then flagged=true; reason="edge-of-reach contact" end
            if velDelta>120 then flagged=true; reason=(reason and reason.." + " or "").."extreme velocity delta" end
        end
        SESSION.touches += 1
        SESSION.totalDistance += distToBall
        if distToBall>SESSION.longestReach then SESSION.longestReach = distToBall end
        if flagged then
            SESSION.flaggedTouches += 1
            SESSION.violations += 1
            SESSION.suspiciousEvents += 1
        end
        SESSION.uniqueBalls[bid] = true
        trackReach(distToBall, flagged, isGK(player))
        if (tick()-SESSION.lastTouchAt)<1.5 then
            SESSION.streak += 1
            if SESSION.streak>SESSION.maxStreak then SESSION.maxStreak = SESSION.streak end
        else SESSION.streak = 1 end
        SESSION.lastTouchAt = tick()
        local team = getTeamInfo()
        table.insert(touchLog, {time=nowStamp(), ball=ball.Name,
            dist=string.format("%.2f",distToBall),
            kind=flagged and "flagged" or "touch", team=team.name})
        pushTimeline(flagged and "FLAGGED TOUCH" or "BALL TOUCH", team.name, player.Name,
            string.format("%.2f studs", distToBall))
        local eid = genEventId()
        sendBallWebhook(ball.Name, distToBall, bid, false, {
            velocity=postVel, position=postPos, flagged=flagged,
            spin=ball.AssemblyAngularVelocity or Vector3.zero,
            owner=ownershipBadge(ball),
            kind=flagged and "unnatural" or "reach-contact",
            team=team.name, reason=reason, eventId=eid})
        if flagged then
            sendFlagWebhook(ball.Name, distToBall, {
                velocity=postVel, position=postPos, reason=reason,
                kind="unnatural", team=team.name, eventId=eid})
        end
    end)
end
local function processAllBalls()
    local char = player.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if not (nuluxSettings.reachOn or nuluxSettings.gkReachOn or nuluxSettings.feetReachOn) then return end
    local totalX = nuluxSettings.reachX
    local totalY = nuluxSettings.reachY
    local totalZ = nuluxSettings.reachZ
    local halfX,halfY,halfZ = totalX*.5, totalY*.5, totalZ*.5
    local hitbox = Vector3.new(totalX,totalY,totalZ)
    if char~=limbCacheChar then limbCache = nil end
    local balls = getAllBalls()
    local hrpPos = hrp.Position
    for _,ball in balls do
        if validateBall(ball) then
            local bp = ball.Position
            local dx = math.abs(hrpPos.X-bp.X)
            local dy = math.abs(hrpPos.Y-bp.Y)
            local dz = math.abs(hrpPos.Z-bp.Z)
            if dx<=halfX and dy<=halfY and dz<=halfZ then
                local dist = math.sqrt(dx*dx+dy*dy+dz*dz)
                local preVel = ball.AssemblyLinearVelocity or Vector3.zero
                local prePos = ball.Position
                doReachContact(char, ball, dist, hitbox, preVel, prePos, tostring(ball))
            end
        end
    end
end

