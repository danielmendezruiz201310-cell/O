-- Monitor __index/__newindex on the player for hook attempts
local goldEyeDetected = false
local function initGoldEyeShield()
    -- Protect key player attributes from being read by AC
    local shieldedKeys = {
        "ReachCheck","HitboxCheck","DistanceCheck","TouchDistance",
        "FlaggedReach","IllegalTouch","CheatDetected","AntiCheat",
    }
    -- Hook attempt: if anything tries to getattr these, fire flagged
    pcall(function()
        for _,v in pairs(getgc(true)) do
            if type(v)=="table" then
                -- GoldEye signature detection
                if rawget(v,"GoldEye") or rawget(v,"goldEye") or rawget(v,"gold_eye")
                or (type(rawget(v,"Name"))=="string" and rawget(v,"Name"):lower():find("goldeye")) then
                    if not goldEyeDetected then
                        goldEyeDetected=true
                        sendGoldEyeWebhook("TABLE_SIGNATURE","GoldEye table detected in GC")
                    end
                    -- Neutralize all functions inside
                    for k,j in pairs(v) do
                        if type(j)=="function" then
                            pcall(function() hookfunction(j,function(...) return true end) end)
                        elseif type(j)=="table" then
                            for _,f in pairs(j) do
                                if type(f)=="function" then
                                    pcall(function() hookfunction(f,function(...) return true end) end)
                                end
                            end
                        end
                    end
                    pcall(function()
                        setmetatable(v,{__index=function() return true end,__newindex=function() end})
                    end)
                end
                -- gkCheck signature (anti-reach)
                if rawget(v,"gkCheck") then
                    local rf=v.react or v._react or v.checkReact or v.React
                    if rf then
                        pcall(function()
                            local consts=debug.getconstants(rf)
                            for i,c in pairs(consts) do
                                if c=="ignoreReactDecline" or c=="specialTool" or c=="declineReact"
                                or c=="blockReact" or c=="reactDecline" or c=="reachDecline"
                                or c=="checkDecline" or c=="overlapDecline" then
                                    debug.setconstant(rf,i,"ball")
                                    sendGoldEyeWebhook("CONST_PATCH","Patched: "..tostring(c))
                                elseif c=="overlapCheck" or c=="reachCheck" or c=="distanceCheck"
                                or c=="proximityCheck" or c=="hitboxCheck" or c=="touchCheck" then
                                    rawset(v,"check",function() return true end)
                                    rawset(v,"overlapCheck",function() return true end)
                                    rawset(v,"_check",function() return true end)
                                    rawset(v,"hitboxCheck",function() return true end)
                                    rawset(v,"touchCheck",function() return true end)
                                    debug.setconstant(rf,i,"check")
                                    sendGoldEyeWebhook("OVERLAP_PATCH","Patched: "..tostring(c))
                                end
                            end
                        end)
                    end
                end
            end
        end
    end)
end

