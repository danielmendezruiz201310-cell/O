local function updateAllViz()
    local now=tick()
    if now-lastVizUpdate<VIZ_INTERVAL then return end
    lastVizUpdate=now
    if not (nuluxSettings.reachVis or nuluxSettings.gkReachVis) then
        if next(vizParts) then for _,vp in pairs(vizParts) do vp.Parent=nil end; vizParts={} end
        return
    end
    local totalX=nuluxSettings.reachX+nuluxSettings.gkReachX
    local totalY=nuluxSettings.reachY+nuluxSettings.gkReachY
    local totalZ=nuluxSettings.reachZ+nuluxSettings.gkReachZ
    local trans=(nuluxSettings.reachTransparency+nuluxSettings.gkReachTransparency)/200
    local sizeV=Vector3.new(totalX,totalY,totalZ)
    local ballSet={}
    for _,ball in getAllBalls() do
        if validateBall(ball) then
            local bid=tostring(ball)
            ballSet[bid]=true
            local vp=vizParts[bid]
            if not vp or not vp.Parent then vp=makeVizPart(bid); vp.Parent=Workspace; vizParts[bid]=vp end
            vp.Size=sizeV; vp.CFrame=CFrame.new(ball.Position); vp.Transparency=trans
        end
    end
    for bid,vp in pairs(vizParts) do
        if not ballSet[bid] then vp.Parent=nil; vizParts[bid]=nil end
    end
end

-- ================================================================
-- RAINBOW BEAM PREDICTOR (smooth continuous line)
-- ================================================================
local predFolder
local predBeams = {} -- per ball: {beamPart, attachment0, attachment1, beam}
local PRED_INTERVAL = 1/40
local lastPredUpdate = 0

local function destroyPredForBall(bid)
    local c=predBeams[bid]
    if not c then return end
    for _,v in pairs(c) do
        pcall(function()
            if type(v)=="table" then
                for _,x in pairs(v) do if x and x.Parent then x.Parent=nil; x:Destroy() end end
            elseif v and v.Parent then v.Parent=nil; v:Destroy() end
        end)
    end
    predBeams[bid]=nil
end

local function simulateTrajectory(startPos,startVel,steps,dt)
    local GRAVITY=Vector3.new(0,-Workspace.Gravity,0)
    local BOUNCE=nuluxSettings.predBounceDamp
    local FRIC=nuluxSettings.predFriction
    local GROUNDY=nuluxSettings.predGroundY
    local pts={startPos}
    local pos,vel=startPos,startVel
    for i=1,steps do
        vel=vel+GRAVITY*dt
        local npos=pos+vel*dt
        if nuluxSettings.predBounces and npos.Y<GROUNDY and vel.Y<0 then
            npos=Vector3.new(npos.X,GROUNDY,npos.Z)
            vel=Vector3.new(vel.X*FRIC,-vel.Y*BOUNCE,vel.Z*FRIC)
        end
        pos=npos; table.insert(pts,pos)
        if pos.Y<-20 then break end
    end
    return pts
end

local function updateBallPrediction()
    local now=tick()
    if now-lastPredUpdate<PRED_INTERVAL then return end
    lastPredUpdate=now

    if not nuluxSettings.ballPredOn then
        for bid in pairs(predBeams) do destroyPredForBall(bid) end
        if predFolder then predFolder:ClearAllChildren() end
        return
    end

    if not predFolder then
        predFolder=Instance.new("Folder")
        predFolder.Name="NuluxPredictor"
        predFolder.Parent=Workspace
    end

    local baseHue=(now*nuluxSettings.predRainbowSpeed)%1
    local active={}

    for _,ball in getAllBalls() do
        if validateBall(ball) then
            local vel=ball.AssemblyLinearVelocity
            if vel and vel.Magnitude>=nuluxSettings.predMinSpeed then
                local bid=tostring(ball)
                active[bid]=true

                -- simulate
                local pts=simulateTrajectory(ball.Position,vel,nuluxSettings.predSteps,0.018)

                -- resample to ~60 points
                local step=math.max(1,math.floor(#pts/60))
                local drawn={}
                for i=1,#pts,step do table.insert(drawn,pts[i]) end

                if #drawn<2 then destroyPredForBall(bid); continue end

                -- ensure segment parts exist
                if not predBeams[bid] then predBeams[bid]={segs={}} end
                local cache=predBeams[bid]

                -- create/reuse segment parts
                while #cache.segs<#drawn-1 do
                    local seg=Instance.new("Part")
                    seg.Anchored=true; seg.CanCollide=false; seg.CanQuery=false
                    seg.CanTouch=false; seg.Massless=true; seg.CastShadow=false
                    seg.Material=Enum.Material.Neon
                    seg.Shape=Enum.PartType.Block
                    seg.Size=Vector3.new(nuluxSettings.predLineWidth,nuluxSettings.predLineWidth,1)
                    seg.Parent=predFolder
                    table.insert(cache.segs,seg)
                end

                -- update segments
                local segCount=#drawn-1
                for i=1,#cache.segs do
                    local seg=cache.segs[i]
                    if i<=segCount then
                        local a,b=drawn[i],drawn[i+1]
                        local diff=b-a
                        local len=diff.Magnitude
                        if len>0.02 then
                            local t_=i/segCount
                            -- smooth rainbow
                            local hue=(baseHue+t_*0.75)%1
                            local sat=0.9
                            local val_=1-t_*0.15
                            seg.Color=Color3.fromHSV(hue,sat,val_)
                            -- smooth fade
                            seg.Transparency=0.08+t_*0.55
                            seg.Size=Vector3.new(nuluxSettings.predLineWidth,nuluxSettings.predLineWidth,len+0.04)
                            seg.CFrame=CFrame.lookAt((a+b)/2,b)
                        else
                            seg.Transparency=1
                        end
                    else
                        seg.Transparency=1
                    end
                end
            else
                destroyPredForBall(tostring(ball))
            end
        end
    end

    for bid in pairs(predBeams) do
        if not active[bid] then destroyPredForBall(bid) end
    end
end

