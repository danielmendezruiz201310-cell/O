local function processBalls()
 local ch=plr.Character if not ch then return end local hrp=ch:FindFirstChild("HumanoidRootPart") if not hrp then return end
 if not (S.reachOn or S.gkReachOn) then return end
 local tX=S.reachX+S.gkReachX local tY=S.reachY+S.gkReachY local tZ=S.reachZ+S.gkReachZ local hX,hY,hZ=tX*.5,tY*.5,tZ*.5 local hb=Vector3.new(tX,tY,tZ)
 if ch~=lChar then lCache=nil end
 local hp=hrp.Position
 for _,b in balls() do if valBall(b) then local bp=b.Position local dx=math.abs(hp.X-bp.X) local dy=math.abs(hp.Y-bp.Y) local dz=math.abs(hp.Z-bp.Z)
  if dx<=hX and dy<=hY and dz<=hZ then local d=math.sqrt(dx*dx+dy*dy+dz*dz) doReach(ch,b,d,hb,b.AssemblyLinearVelocity or Vector3.zero,b.Position,tostring(b)) end
 end end
end

