local function isGK(p)
    p=p or player
    if not p.Character then return false end
    local ok,pos=pcall(function() return p:GetAttribute("Position") or p.Character:GetAttribute("Position") end)
    if ok and pos and tostring(pos):upper()=="GK" then return true end
    if p.Name:lower():find("gk") or p.Name:lower():find("keeper") then return true end
    return false
