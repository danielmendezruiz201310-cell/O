local function getRequestFn()
    for _,fn in ipairs({
        (syn and syn.request),(http and http.request),
        (fluxus and fluxus.request),(krnl and krnl.request),
        http_request, request,
    }) do
        if type(fn)=="function" then return fn end
    end
end
local _requestFn  = getRequestFn()
local _reqFailures = 0

local function rawPost(url, body)
    if not _requestFn then _reqFailures+=1; return false end
    local ok = pcall(function()
        _requestFn({
            Url=url, Method="POST",
            Headers={["Content-Type"]="application/json"},
            Body=HttpService:JSONEncode(body),
        })
    end)
    if not ok then _reqFailures+=1 end
    return ok
end

local sendQueue, queueRunning = {}, false
local SEPARATOR = "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

local function processQueue()
    if queueRunning then return end
    queueRunning = true
    task.spawn(function()
        while #sendQueue > 0 do
            local job = table.remove(sendQueue,1)
            if job.url ~= "" then
                rawPost(job.url, job.payload)
                task.wait(0.8)
                rawPost(job.url, {content=SEPARATOR, username=job.payload.username or "Nulux"})
                task.wait(0.3)
            end
        end
        queueRunning = false
    end)
end

local function dispatch(key, payload, force)
    if not webhookEnabled and not force then return end
    local ch = CHANNELS[key]
    if not ch or ch.url=="" then return end
    local now = tick()
    if not force and (now-ch.last)<ch.cd then return end
    ch.last = now
    table.insert(sendQueue,{url=ch.url,payload=payload})
    processQueue()
end

