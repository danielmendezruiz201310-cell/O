local function getMatchData()
    local homeTeam,awayTeam=nil,nil
    local allTeams=Teams:GetTeams()
    if #allTeams>=2 then homeTeam=allTeams[1]; awayTeam=allTeams[2]
    elseif #allTeams==1 then homeTeam=allTeams[1] end
    local home,away={gk=nil,players={}},{gk=nil,players={}}
    for _,p in Players:GetPlayers() do
        local side=nil
        if homeTeam and p.Team==homeTeam then side="home"
        elseif awayTeam and p.Team==awayTeam then side="away" end
        if side then
            local entry={name=p.Name,id=p.UserId,team=p.Team and p.Team.Name or "—",flags=0,status="CLEAN",position="FIELD"}
            local ok,pos=pcall(function() return p:GetAttribute("Position") or (p.Character and p.Character:GetAttribute("Position")) end)
            if ok and pos then entry.position=tostring(pos):upper() end
            if p.Name:lower():find("gk") or p.Name:lower():find("keeper") then entry.position="GK" end
            for _,log in acLog do if log.player==p.Name then entry.flags+=1; entry.status="FLAGGED" end end
            if entry.position=="GK" then
                if side=="home" then home.gk=entry else away.gk=entry end
            else
                if side=="home" then table.insert(home.players,entry) else table.insert(away.players,entry) end
            end
        end
    end
    local function hexFromTeam(t)
        if not t then return "#888888" end
        local c=t.TeamColor.Color
        return string.format("#%02X%02X%02X",math.floor(c.R*255),math.floor(c.G*255),math.floor(c.B*255))
    end
    return {
        home=home, away=away,
        homeName=homeTeam and homeTeam.Name or "HOME",
        awayName=awayTeam and awayTeam.Name or "AWAY",
        homeHex=hexFromTeam(homeTeam), awayHex=hexFromTeam(awayTeam),
    }
end

local function getSideTag(teamName)
    local md=getMatchData()
    if teamName==md.homeName then return "home"
    elseif teamName==md.awayName then return "away" end
    return nil
end

