local ballKeywords={"ball","soccerball","soccer_ball","football","gameball","matchball","futball","roundball","theball","playball","bola","freekick","ballpart","puck"}
local function isCharacterPart(part)
    if not part or not part.Parent then return true end
    local p,depth=part,0
    while p and p~=Workspace and depth<10 do
        if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then return true end
        if p:IsA("Accessory") or p:IsA("Tool") then return true end
        p=p.Parent; depth+=1
    end
    return false
end
local function validateBall(part)
    if not part or not part.Parent then return false end
    if not part:IsA("BasePart") then return false end
    if isCharacterPart(part) then return false end
    if player.Character and part:IsDescendantOf(player.Character) then return false end
    return true
end
local ballCache,ballCacheTime={},0
local BALL_CACHE_TTL=0.5
local function getAllBalls()
    local now=tick()
    if now-ballCacheTime<BALL_CACHE_TTL and #ballCache>0 then
        for i=#ballCache,1,-1 do if not ballCache[i].Parent or not validateBall(ballCache[i]) then table.remove(ballCache,i) end end
        return ballCache
    end
    local found,seen={},{}
    for _,v in CollectionService:GetTagged("Ball") do
        if validateBall(v) and not seen[v] then seen[v]=true; table.insert(found,v) end
    end
    for _,v in pairs(Workspace:GetDescendants()) do
        if validateBall(v) and not seen[v] then
            local n=v.Name:lower()
            for _,kw in ballKeywords do if n:find(kw) then seen[v]=true; table.insert(found,v); break end end
        end
    end
    ballCache,ballCacheTime=found,now
    return found
end

