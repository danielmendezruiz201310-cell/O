    ind.Size=UDim2.new(0,3,0,0); ind.Position=UDim2.new(1,-3,0.5,0)
    ind.AnchorPoint=Vector2.new(1,0.5); ind.BackgroundColor3=color or C.accent
    ind.BorderSizePixel=0; corner(ind,2)
    local page=Instance.new("ScrollingFrame",Container)
    page.Size=UDim2.new(1,0,1,0); page.BackgroundTransparency=1; page.Visible=false
    page.ScrollBarThickness=3; page.ScrollBarImageColor3=C.border; page.BorderSizePixel=0
    local L=Instance.new("UIListLayout",page)
    L.Padding=UDim.new(0,8); L.SortOrder=Enum.SortOrder.LayoutOrder
    pad(page,0,6,6,4,4)
    local function activate()
        if activeTabBtn==Btn then return end
        for _,v in pairs(Pages) do
            v.Page.Visible=false
            TweenService:Create(v.Btn,TweenInfo.new(0.2),{BackgroundTransparency=1}):Play()
            TweenService:Create(v.Lbl,TweenInfo.new(0.2),{TextColor3=C.textDim}):Play()
            TweenService:Create(v.Ind,TweenInfo.new(0.2),{Size=UDim2.new(0,3,0,0)}):Play()
        end
        page.Visible=true
        page.Position=UDim2.new(0,20,0,0)
        TweenService:Create(page,TweenInfo.new(0.35,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,0,0)}):Play()
        TweenService:Create(Btn,TweenInfo.new(0.2),{BackgroundTransparency=0,BackgroundColor3=C.panel3}):Play()
        TweenService:Create(lbl,TweenInfo.new(0.2),{TextColor3=C.text}):Play()
        TweenService:Create(ind,TweenInfo.new(0.35,Enum.EasingStyle.Back),{Size=UDim2.new(0,3,0,24)}):Play()
        activeTabBtn=Btn
    end
    Btn.MouseEnter:Connect(function() if activeTabBtn~=Btn then TweenService:Create(lbl,TweenInfo.new(0.15),{TextColor3=C.text}):Play() end end)
    Btn.MouseLeave:Connect(function() if activeTabBtn~=Btn then TweenService:Create(lbl,TweenInfo.new(0.15),{TextColor3=C.textDim}):Play() end end)
    Btn.MouseButton1Click:Connect(activate)
    Pages[name]={Page=page,Btn=Btn,Lbl=lbl,Ind=ind,Activate=activate}
    return page
end

