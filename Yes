-- PREDICTOR
local pf,pb,lastPred={},{},0
local function killPred(id) local c=pb[id] if not c then return end for _,v in pairs(c) do pcall(function() if v and v.Parent then v:Destroy() end end) end pb[id]=nil end
local function simTraj(p0,v0,steps,dt)
 local G=Vector3.new(0,-WS.Gravity,0) local B=S.predBounceDamp local F=S.predFriction local GY=S.predGroundY local pts={p0} local p,v=p0,v0
 for _=1,steps do v=v+G*dt local np=p+v*dt if S.predBounces and np.Y<GY and v.Y<0 then np=Vector3.new(np.X,GY,np.Z) v=Vector3.new(v.X*F,-v.Y*B,v.Z*F) end p=np pts[#pts+1]=p if p.Y<-20 then break end end
 return pts
end
local function updPred()
 local n=tick() if n-lastPred<1/40 then return end lastPred=n
 if not S.ballPredOn then for id in pb do killPred(id) end if pf then pf:ClearAllChildren() end return end
 if not pf then pf=Instance.new("Folder") pf.Name="NuluxPredictor" pf.Parent=WS end
 local bh=(n*S.predRainbowSpeed)%1 local act={}
 for _,b in balls() do if valBall(b) then local v=b.AssemblyLinearVelocity
  if v and v.Magnitude>=S.predMinSpeed then
   local id=tostring(b) act[id]=true local pts=simTraj(b.Position,v,S.predSteps,0.018) local st=math.max(1,math.floor(#pts/60)) local dr={} for i=1,#pts,st do dr[#dr+1]=pts[i] end
   if #dr<2 then killPred(id) else
    if not pb[id] then pb[id]={segs={}} end local c=pb[id]
    while #c.segs<#dr-1 do local sg=Instance.new("Part") sg.Anchored=true sg.CanCollide=false sg.CanQuery=false sg.CanTouch=false sg.Massless=true sg.CastShadow=false sg.Material=Enum.Material.Neon sg.Shape=Enum.PartType.Block sg.Size=Vector3.new(S.predLineWidth,S.predLineWidth,1) sg.Parent=pf c.segs[#c.segs+1]=sg end
    local sc=#dr-1
    for i=1,#c.segs do local sg=c.segs[i]
     if i<=sc then local a,bb=dr[i],dr[i+1] local df=bb-a local ln=df.Magnitude
      if ln>0.02 then local tt=i/sc local hu=(bh+tt*0.75)%1 sg.Color=Color3.fromHSV(hu,0.9,1-tt*0.15) sg.Transparency=0.08+tt*0.55 sg.Size=Vector3.new(S.predLineWidth,S.predLineWidth,ln+0.04) sg.CFrame=CFrame.lookAt((a+bb)/2,bb) else sg.Transparency=1 end
     else sg.Transparency=1 end
    end
   end
  else killPred(tostring(b)) end
 end end
 for id in pb do if not act[id] then killPred(id) end end
end

