local function Slider(parent,text,min_,max_,default,cb)
    local F=Instance.new("Frame",parent)
    F.Size=UDim2.new(1,-8,0,60); F.BackgroundColor3=C.panel2
    F.BorderSizePixel=0; corner(F,10); stroke(F,C.border)
