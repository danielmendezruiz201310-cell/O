 for _,p in Players:GetPlayers() do local side if hT and p.Team==hT then side="home" elseif aT and p.Team==aT then side="away" end
  if side then local en={name=p.Name,id=p.UserId,team=p.Team and p.Team.Name or "—",flags=0,status="CLEAN",position="FIELD"}
   local ok,ps=pcall(function() return p:GetAttribute("Position") or (p.Character and p.Character:GetAttribute("Position")) end) if ok and ps then en.position=tostring(ps):upper() end
