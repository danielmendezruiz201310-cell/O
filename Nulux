local function sessionCard()
    local uniq = 0; for _ in pairs(SESSION.uniqueBalls) do uniq = uniq + 1 end
    local streakPct = SESSION.maxStreak > 0 and (SESSION.streak/SESSION.maxStreak) or 0
    local flagPct   = SESSION.touches    > 0 and (SESSION.flaggedTouches/SESSION.touches) or 0
    return table.concat({
        treeTop("SESSION COUNTERS", "stats"),
        treeRow("hitbox_status", "TOUCHES",  SESSION.touches),
        treeRow("ball",          "UNIQUE",   uniq),
        treeRow("streak",        "STREAK",   SESSION.streak.." / "..SESSION.maxStreak),
        treeRow("distance",      "LONGEST",  string.format("%.1f studs", SESSION.longestReach)),
        treeRow("flagged",       "FLAGS",    SESSION.flaggedTouches),
        treeBar("streak",        "STREAK",   streakPct, 10),
        treeBar("flagged",       "FLAG RATE",flagPct, 10),
        treeBot(),
    }, "\n")
end

local function recentCard()
    local lines = {treeTop("RECENT TOUCHES", "ball")}
    if #touchLog == 0 then
        lines[#lines+1] = "│ `no events recorded`"
    else
        for i = math.max(1, #touchLog-5), #touchLog do
            local t = touchLog[i]
            lines[#lines+1] = "│ `"..t.time.."` "..padV(t.ball,10).." `"..string.format("%6s",t.dist).."` "..(t.kind or "touch")
        end
    end
    lines[#lines+1] = treeBot()
    return table.concat(lines, "\n")
end

