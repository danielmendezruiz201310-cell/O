local LIMB_CANDIDATES = {
    {"HumanoidRootPart"},{"Head"},
    {"UpperTorso","Torso"},{"LowerTorso"},
    {"LeftUpperArm","Left Arm"},{"RightUpperArm","Right Arm"},
    {"LeftLowerArm","Left Arm"},{"RightLowerArm","Right Arm"},
    {"LeftHand"},{"RightHand"},
    {"LeftUpperLeg","Left Leg"},{"RightUpperLeg","Right Leg"},
    {"LeftLowerLeg","Left Leg"},{"RightLowerLeg","Right Leg"},
    {"LeftFoot","Left Leg"},{"RightFoot","Right Leg"},
}
local limbCache, limbCacheChar = nil, nil
local function getLimbs(char)
    if char == limbCacheChar and limbCache then return limbCache end
    local seen, t = {}, {}
    for _,group in ipairs(LIMB_CANDIDATES) do
        for _,n in ipairs(group) do
            local p = char:FindFirstChild(n, true)
            if p and p:IsA("BasePart") and not seen[p] then
                seen[p] = true
                table.insert(t, p)
                break
            end
        end
    end
    limbCache, limbCacheChar = t, char
    return t
end

-- ================================================================
-- REACH
-- ================================================================
local contactLast = {}

local function fireBallContact(char, ball)
    local limbs = getLimbs(char)
    if #limbs == 0 then return end
    for _,limb in ipairs(limbs) do
        pcall(function() firetouchinterest(limb, ball, 0) end)
    end
    task.defer(function()
        task.wait(0.03)
        for _,limb in ipairs(limbs) do
            pcall(function() firetouchinterest(limb, ball, 1) end)
        end
    end)
end

local function firePlayerContact(char, target, limbs)
    for _,limb in ipairs(limbs) do
        pcall(function() firetouchinterest(limb, target, 0) end)
    end
    task.defer(function()
        task.wait(0.03)
        for _,limb in ipairs(limbs) do
            pcall(function() firetouchinterest(limb, target, 1) end)
        end
    end)
end

local function doReachContact(char, ball, distToBall, hitbox, preVel, prePos, bid)
    local now = tick()
    local minGap = nuluxSettings.contactThrottleMs / 1000
    if contactLast[bid] and (now - contactLast[bid]) < minGap then return end
    contactLast[bid] = now

    local limbs = getLimbs(char)
    if #limbs == 0 then return end

    fireBallContact(char, ball)

    if nuluxSettings.reachPlayers then
        task.spawn(function()
            pcall(function()
                local params = OverlapParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {char}
                params.MaxParts = 8
                local parts = Workspace:GetPartBoundsInBox(CFrame.new(ball.Position), hitbox, params)
                if #parts == 0 then return end
                local seen = {}
                for _,part in ipairs(parts) do
                    local oc = part:FindFirstAncestorOfClass("Model")
                    if oc and oc ~= char and oc:FindFirstChildOfClass("Humanoid") and not seen[oc] then
                        seen[oc] = true
                        firePlayerContact(char, part, limbs)
                        SESSION.contacts = SESSION.contacts + 1
                    end
                end
            end)
        end)
    end

    task.defer(function()
        task.wait(0.06)
        if not ball.Parent then return end
        local postVel = ball.AssemblyLinearVelocity or Vector3.zero
        local postPos = ball.Position
        local velDelta = (postVel - preVel).Magnitude
        local posDelta = (postPos - prePos).Magnitude
        local realTouch = nuluxSettings.ignoreVelocityCheck
            or velDelta >= nuluxSettings.touchVelocityMin
            or posDelta >= 0.1
        if not realTouch then return end

        local maxReach = math.max(hitbox.X, hitbox.Y, hitbox.Z) * 0.5
        local flagged, reason = false, nil
        if nuluxSettings.flagUnnatural then
            if distToBall > (maxReach * 0.9) then flagged=true reason="edge-of-reach contact" end
            if velDelta > 120 then flagged=true reason=(reason and reason.." + " or "").."extreme velocity delta" end
        end

        SESSION.touches = SESSION.touches + 1
        SESSION.totalDistance = SESSION.totalDistance + distToBall
        if distToBall > SESSION.longestReach then SESSION.longestReach = distToBall end
        if flagged then SESSION.flaggedTouches = SESSION.flaggedTouches + 1 end
        SESSION.uniqueBalls[bid] = true

        if (tick() - SESSION.lastTouchAt) < 1.5 then
            SESSION.streak = SESSION.streak + 1
            if SESSION.streak > SESSION.maxStreak then SESSION.maxStreak = SESSION.streak end
        else SESSION.streak = 1 end
        SESSION.lastTouchAt = tick()

        table.insert(touchLog, {
            time=os.date("%H:%M:%S"), ball=ball.Name,
            dist=string.format("%.2f", distToBall),
            kind=flagged and "flagged" or "touch"
        })

        sendBallWebhook(ball.Name, distToBall, bid, false, {
            velocity=postVel, position=postPos, flagged=flagged,
            kind=flagged and "unnatural" or "reach-contact"
        })
        if flagged then
            sendFlagWebhook(ball.Name, distToBall, { velocity=postVel, position=postPos, reason=reason })
        end
    end)
end

local function processAllBalls()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not (nuluxSettings.reachOn or nuluxSettings.gkReachOn) then return end

    local totalX = nuluxSettings.reachX + nuluxSettings.gkReachX
    local totalY = nuluxSettings.reachY + nuluxSettings.gkReachY
    local totalZ = nuluxSettings.reachZ + nuluxSettings.gkReachZ
    local halfX, halfY, halfZ = totalX*0.5, totalY*0.5, totalZ*0.5
    local hitbox = Vector3.new(totalX, totalY, totalZ)

    if char ~= limbCacheChar then limbCache = nil end

    local balls = getAllBalls()
    local hrpPos = hrp.Position

    for _,ball in ipairs(balls) do
        if ball.Parent then
            local bp = ball.Position
            local dx = math.abs(hrpPos.X - bp.X)
            local dy = math.abs(hrpPos.Y - bp.Y)
            local dz = math.abs(hrpPos.Z - bp.Z)
            if dx <= halfX and dy <= halfY and dz <= halfZ then
                local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
                local preVel = ball.AssemblyLinearVelocity or Vector3.zero
                local prePos = ball.Position
                doReachContact(char, ball, dist, hitbox, preVel, prePos, tostring(ball))
            end
        end
    end
end

-- ================================================================
-- VISUALIZER
-- ================================================================
local vizParts = {}
local lastVizUpdate = 0
local VIZ_INTERVAL = 1/30

local function makeVizPart(bid)
    local vp = Instance.new("Part")
    vp.Name = "NuluxViz_"..bid
    vp.Anchored = true
    vp.CanCollide = false
    vp.CanQuery = false
    vp.CanTouch = false
    vp.Massless = true
    vp.CastShadow = false
    vp.Shape = Enum.PartType.Ball
    vp.Material = nuluxSettings.vizQuality == 1 and Enum.Material.ForceField or Enum.Material.SmoothPlastic
    vp.Color = Color3.fromRGB(120,200,255)
    return vp
end

local function updateAllViz()
    local now = tick()
    if now - lastVizUpdate < VIZ_INTERVAL then return end
    lastVizUpdate = now
    if not (nuluxSettings.reachVis or nuluxSettings.gkReachVis) then
        if next(vizParts) then
            for _,vp in pairs(vizParts) do vp.Parent = nil end
            vizParts = {}
        end
        return
    end
    local totalX = nuluxSettings.reachX + nuluxSettings.gkReachX
    local totalY = nuluxSettings.reachY + nuluxSettings.gkReachY
    local totalZ = nuluxSettings.reachZ + nuluxSettings.gkReachZ
    local trans  = (nuluxSettings.reachTransparency + nuluxSettings.gkReachTransparency) / 200
    local sizeV  = Vector3.new(totalX, totalY, totalZ)

    local ballSet = {}
    for _,ball in ipairs(getAllBalls()) do
        if ball.Parent then
            local bid = tostring(ball)
            ballSet[bid] = true
            local vp = vizParts[bid]
            if not vp or not vp.Parent then
                vp = makeVizPart(bid); vp.Parent = Workspace; vizParts[bid] = vp
            end
            vp.Size = sizeV
            vp.CFrame = CFrame.new(ball.Position)
            vp.Transparency = trans
        end
    end
    for bid,vp in pairs(vizParts) do
        if not ballSet[bid] then vp.Parent = nil vizParts[bid] = nil end
    end
end

