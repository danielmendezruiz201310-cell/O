        local rf=v.react or v._react or v.checkReact or v.React
        if rf then
            local consts=debug.getconstants(rf)
            for i,c in pairs(consts) do
                if c=="ignoreReactDecline" or c=="specialTool" or c=="declineReact" or c=="blockReact" or c=="reactDecline" then
                    debug.setconstant(rf,i,"ball")
                elseif c=="overlapCheck" or c=="reachCheck" or c=="distanceCheck" or c=="proximityCheck" then
                    rawset(v,"check",function() return true end)
                    rawset(v,"overlapCheck",function() return true end)
                    rawset(v,"_check",function() return true end)
                    debug.setconstant(rf,i,"check")
                end
            end
        end
    end
end
