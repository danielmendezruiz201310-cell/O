local PLAYER_AVATAR = "https://www.roblox.com/headshot-thumbnail/image?userId="..player.UserId.."&width=150&height=150&format=png"
local NAME_TAG = icon("user","👤").." **`"..player.Name.."`**"
local TREE_W = 26

local function bar(pct, len)
    len = len or 12
    pct = math.clamp(pct, 0, 1)
    local f = math.floor(pct*len + 0.5)
    return string.rep("▰", f)..string.rep("▱", len - f)
end

-- visual width: custom emoji count as 2 cols
local function vwidth(s)
    s = tostring(s)
    local n = 0
    for _ in s:gmatch("<a?:[%w_]+:%d+>") do n = n + 1 end
    local stripped = s:gsub("<a?:[%w_]+:%d+>", "")
    return #stripped + n * 2
end
local function padV(s, n)
    s = tostring(s)
    local w = vwidth(s)
    if w >= n then return s end
    return s .. string.rep(" ", n - w)
end

local function treeTop(label, iconKey)
    local ic = iconKey and icon(iconKey,"") or ""
    return ic.." **"..label.."**\n╭"..string.rep("─", TREE_W)
end
local function treeBot()
    return "╰"..string.rep("─", TREE_W)
end
local function treeSep(label)
    return "├─ **"..label.."** "..string.rep("─", math.max(2, TREE_W - #label - 4))
end
local function treeRow(iconKey, label, value, extra)
    local ic = iconKey and icon(iconKey,"") or ""
    local line = "│ "..ic.." "..padV(label, 11).." › `"..tostring(value).."`"
    if extra and extra ~= "" then line = line.." "..extra end
    return line
end
local function treeBar(iconKey, label, pct, w)
    w = w or 10
    pct = math.clamp(pct, 0, 1)
    local f = math.floor(pct*w + 0.5)
    local b = string.rep("▰", f)..string.rep("▱", w - f)
    local ic = iconKey and icon(iconKey,"") or ""
    return "│ "..ic.." "..padV(label, 11).." › `"..b.."` **"..math.floor(pct*100).."%**"
end

