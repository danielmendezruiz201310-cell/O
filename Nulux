-- ================================================================
-- SEND QUEUE
-- ================================================================
local sendQueue, queueRunning = {}, false
local SEPARATOR = "───────────────────────────────────────"
local SEP_DELAY, QUEUE_GAP = 0.9, 0.35

local function rawPost(url, body)
    local reqFn = (syn and syn.request) or http_request or request
    if not reqFn then return false end
    return pcall(function()
        reqFn({ Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=HttpService:JSONEncode(body) })
    end)
end
local function processQueue()
    if queueRunning then return end
    queueRunning = true
    task.spawn(function()
        while #sendQueue > 0 do
            local job = table.remove(sendQueue, 1)
            if job.url and job.url ~= "" then
                rawPost(job.url, job.payload)
                task.wait(SEP_DELAY)
                rawPost(job.url, { content=SEPARATOR, username=job.payload.username or "Nulux Hub" })
                task.wait(QUEUE_GAP)
            end
        end
        queueRunning = false
    end)
end
local function dispatch(key, payload, force)
    if not webhookEnabled and not force then return end
    local ch = CHANNELS[key]
    if not ch or ch.url == "" then return end
    local now = tick()
    if not force and (now - ch.last) < ch.cd then return end
    ch.last = now
    table.insert(sendQueue, { url=ch.url, payload=payload })
    processQueue()
end

