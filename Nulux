local ballKeywords = {
    "ball","soccerball","soccer_ball","football","gameball",
    "matchball","futball","roundball","theball","playball",
    "bola","freekick","ballpart","puck"
}
local ballCache, ballCacheTime = {}, 0
local BALL_CACHE_TTL = 0.5
local function getAllBalls()
    local now = tick()
    if now - ballCacheTime < BALL_CACHE_TTL and #ballCache > 0 then
        for i=#ballCache,1,-1 do if not ballCache[i].Parent then table.remove(ballCache, i) end end
        return ballCache
    end
    local found, seen = {}, {}
    for _,v in CollectionService:GetTagged("Ball") do
        if v:IsA("BasePart") and not seen[v] then seen[v]=true table.insert(found,v) end
    end
    for _,v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and not seen[v] then
            local n = v.Name:lower()
            for _,kw in ipairs(ballKeywords) do
                if n:find(kw) then seen[v]=true table.insert(found,v) break end
            end
        end
    end
    ballCache, ballCacheTime = found, now
    return found
end

