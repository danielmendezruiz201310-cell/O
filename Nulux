local feetHitbox
local function feetReachUpdate()
    pcall(function()
        local char = player.Character
        if not char then if feetHitbox then feetHitbox.Parent=nil end return end
        local rf = char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")
        local lf = char:FindFirstChild("LeftFoot")  or char:FindFirstChild("Left Leg")
        if not (rf or lf) or not nuluxSettings.feetReachOn then
            if feetHitbox then feetHitbox.Parent=nil end return
        end
        if not feetHitbox then
            feetHitbox = Instance.new("Part")
            feetHitbox.Name="NuluxFeetReach" feetHitbox.Anchored=true
            feetHitbox.CanCollide=false feetHitbox.CanQuery=false feetHitbox.CanTouch=false
            feetHitbox.Massless=true
            feetHitbox.Material=Enum.Material.ForceField feetHitbox.Color=Color3.fromRGB(154,255,154)
        end
        local feetC = (rf and lf) and (rf.Position+lf.Position)/2 or (rf and rf.Position or lf.Position)
        local size = Vector3.new(nuluxSettings.feetX, nuluxSettings.feetY, nuluxSettings.feetZ)
        feetHitbox.Size = size feetHitbox.CFrame = CFrame.new(feetC)
        feetHitbox.Transparency = nuluxSettings.feetVis and (nuluxSettings.feetTransparency/100) or 1
        feetHitbox.Parent = Workspace
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char, feetHitbox}
        params.MaxParts = 12
        local parts = Workspace:GetPartBoundsInBox(feetHitbox.CFrame, size, params)
        for _,part in ipairs(parts) do
            if part == feetHitbox or part.Parent == char then continue end
            if rf then task.spawn(function() pcall(function() firetouchinterest(rf,part,0) task.wait() firetouchinterest(rf,part,1) end) end) end
            if lf then task.spawn(function() pcall(function() firetouchinterest(lf,part,0) task.wait() firetouchinterest(lf,part,1) end) end) end
        end
    end)
end

local predFolder
local lastPredUpdate, PRED_INTERVAL = 0, 1/15
local function updateBallPrediction()
    local now = tick()
    if now - lastPredUpdate < PRED_INTERVAL then return end
    lastPredUpdate = now
    pcall(function()
        if not nuluxSettings.ballPredOn then
            if predFolder and #predFolder:GetChildren() > 0 then
                for _,c in pairs(predFolder:GetChildren()) do c:Destroy() end
            end
            return
        end
        if not predFolder then predFolder=Instance.new("Folder",Workspace) predFolder.Name="NuluxPredArc" end
        for _,c in pairs(predFolder:GetChildren()) do c:Destroy() end
        for _,ball in ipairs(getAllBalls()) do
            if not ball.AssemblyLinearVelocity then continue end
            local pos, vel = ball.Position, ball.AssemblyLinearVelocity
            local grav = Vector3.new(0, -Workspace.Gravity*1.05, 0)
            local prev = pos
            for i=1,80 do
                vel = vel + grav*0.012
                local nextPos = prev + vel*0.012
                local seg = Instance.new("Part")
                seg.Anchored=true seg.CanCollide=false seg.CanQuery=false seg.CanTouch=false seg.Massless=true
                seg.Material=Enum.Material.Neon
                seg.Color=Color3.fromRGB(80,255,255)
                seg.Transparency = 0.35 + (i/80)*0.4
                seg.Size = Vector3.new(0.65,0.65,(nextPos-prev).Magnitude+0.1)
                seg.CFrame = CFrame.lookAt(prev,nextPos)*CFrame.new(0,0,-seg.Size.Z/2)
                seg.Parent = predFolder
                prev = nextPos
                if nextPos.Y < -15 or (nextPos-pos).Magnitude > 300 then break end
            end
        end
    end)
end

