local function CreateTab(name)
    local Btn=Instance.new("TextButton",Sidebar)
    Btn.Size=UDim2.new(1,-20,0,34) Btn.BackgroundTransparency=1
    Btn.Text="  "..name Btn.TextColor3=Color3.fromRGB(140,140,140)
    Btn.Font=Enum.Font.GothamMedium Btn.TextSize=13
    Btn.TextXAlignment=Enum.TextXAlignment.Left
    local Ind=Instance.new("Frame",Btn)
    Ind.Size=UDim2.new(0,4,0,0) Ind.Position=UDim2.new(0,0,0.5,0)
    Ind.AnchorPoint=Vector2.new(0,0.5) Ind.BackgroundColor3=Color3.fromRGB(0,150,255)
    Ind.BorderSizePixel=0
    Instance.new("UICorner",Ind).CornerRadius=UDim.new(1,0)
    local Page=Instance.new("ScrollingFrame",Container)
    Page.Size=UDim2.new(1,0,1,0) Page.BackgroundTransparency=1
    Page.Visible=false Page.ScrollBarThickness=3
    Page.ScrollBarImageColor3=Color3.fromRGB(60,60,60)
    local L=Instance.new("UIListLayout",Page)
    L.Padding=UDim.new(0,8) L.SortOrder=Enum.SortOrder.LayoutOrder
    Btn.MouseButton1Click:Connect(function()
        for _,v in pairs(Pages) do
            v.Page.Visible=false
            TweenService:Create(v.Btn,TweenInfo.new(0.2),{TextColor3=Color3.fromRGB(140,140,140)}):Play()
            TweenService:Create(v.Ind,TweenInfo.new(0.2),{Size=UDim2.new(0,4,0,0)}):Play()
        end
        Page.Visible=true
        TweenService:Create(Btn,TweenInfo.new(0.2),{TextColor3=Color3.fromRGB(255,255,255)}):Play()
        TweenService:Create(Ind,TweenInfo.new(0.35,Enum.EasingStyle.Back),{Size=UDim2.new(0,4,0,20)}):Play()
    end)
    Pages[name]={Page=Page,Btn=Btn,Ind=Ind}
    return Page
end

