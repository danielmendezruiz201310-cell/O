local function S(parent,text,min,max,default,cb)
    local SF=Instance.new("Frame",parent)
    SF.Size=UDim2.new(1,-20,0,50) SF.BackgroundColor3=Color3.fromRGB(25,25,25)
    Instance.new("UICorner",SF).CornerRadius=UDim.new(0,8)
    local lbl=Instance.new("TextLabel",SF)
    lbl.Text=text..": "..default lbl.Size=UDim2.new(1,0,0,20)
    lbl.BackgroundTransparency=1 lbl.TextColor3=Color3.fromRGB(220,220,220)
    lbl.Font=Enum.Font.GothamMedium lbl.TextSize=12
    lbl.TextXAlignment=Enum.TextXAlignment.Left lbl.Position=UDim2.new(0,12,0,5)
    local barf=Instance.new("Frame",SF)
    barf.Size=UDim2.new(1,-24,0,6) barf.Position=UDim2.new(0,12,0,30)
    barf.BackgroundColor3=Color3.fromRGB(50,50,50)
    Instance.new("UICorner",barf).CornerRadius=UDim.new(1,0)
    local fill=Instance.new("Frame",barf)
    fill.Size=UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3=Color3.fromRGB(0,170,255)
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
    local function upd(inp)
        local p=math.clamp((inp.Position.X-barf.AbsolutePosition.X)/barf.AbsoluteSize.X,0,1)
        fill.Size=UDim2.new(p,0,1,0)
        local val=math.floor(min+(max-min)*p)
        lbl.Text=text..": "..val cb(val)
    end
    barf.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            upd(inp)
            local c=UserInputService.InputChanged:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then upd(i) end
            end)
            UserInputService.InputEnded:Connect(function() c:Disconnect() end)
        end
    end)
end

local function B(parent,text,cb)
    local Btn=Instance.new("TextButton",parent)
    Btn.Size=UDim2.new(1,-20,0,34) Btn.BackgroundColor3=Color3.fromRGB(30,30,30)
    Btn.Text=text Btn.TextColor3=Color3.fromRGB(220,220,220)
    Btn.Font=Enum.Font.GothamMedium Btn.TextSize=13
    Instance.new("UICorner",Btn).CornerRadius=UDim.new(0,8)
    Btn.MouseEnter:Connect(function() TweenService:Create(Btn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(45,45,45)}):Play() end)
    Btn.MouseLeave:Connect(function() TweenService:Create(Btn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(30,30,30)}):Play() end)
    Btn.MouseButton1Click:Connect(function()
        local c=TweenService:Create(Btn,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(60,60,60)})
        c:Play() c.Completed:Wait()
        TweenService:Create(Btn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(30,30,30)}):Play()
        cb()
    end)
end

